{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision (mens -> console)",
  "type": "object",
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "reject",
        "discard",
        "release_original"
      ]
    },
    "comment": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "save_as_rule": {
      "type": "boolean",
      "description": "Bij approve: bewaar het recept als blijvende regel voor incidenten met dezelfde bevindingen."
    }
  },
  "required": [
    "decision"
  ],
  "additionalProperties": false
}
