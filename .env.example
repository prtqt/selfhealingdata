# Kopieer naar .env en vul in.

# Claude: nodig voor de healer, en voor de chaos-agent als CHAOS_MODE=llm.
ANTHROPIC_API_KEY=

# Brondata. kaggle: echte Olist-data (token nodig, of zet de CSV's zelf in data/source/raw).
#           synthetic: nagemaakte data met dezelfde kolommen, geen account nodig.
DATASET=kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=
START_DATE=2017-02-06
FEED_INTERVAL=120          # seconden tussen twee weekbatches
MAX_BATCHES=0              # 0 = alle weken

# Chaos.
CHAOS_MODE=random          # random | llm (Claude Haiku kiest de verstoring)
CHAOS_PROBABILITY=0.3
CHAOS_WARMUP_BATCHES=4     # eerst zoveel schone batches, als referentie voor het volume

# Pipeline: bestellingen zonder bevinding alvast doorlaten als hoogstens dit aandeel van de batch is geraakt.
PARTIAL_RELEASE=true
PARTIAL_MAX_SHARE=0.5

# Console.
MAX_ATTEMPTS=3             # pogingen van de healer voordat een mens het overneemt

# Meldingen: webhook in Slack-formaat. Krijgt een bericht zodra iets op een besluit wacht. Leeg = uit.
NOTIFY_WEBHOOK_URL=
CONSOLE_PUBLIC_URL=http://localhost:8000

# Login op de console. Leeg = geen login (alleen lokaal doen).
#   CONSOLE_USERS      naam:rol:wachtwoord, gescheiden door komma's; rol is po (mag beslissen) of dev (alleen lezen)
#   CONSOLE_API_TOKEN  gedeeld geheim waarmee pipeline en healer zich melden; verplicht zodra er gebruikers zijn
#   CONSOLE_SECRET     ondertekent sessies; leeg = bij elke herstart opnieuw inloggen
CONSOLE_USERS=
CONSOLE_API_TOKEN=
CONSOLE_SECRET=
